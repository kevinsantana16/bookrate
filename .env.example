# Exemplo de variáveis de ambiente para o projeto
# Copie este ficheiro para ".env" e preencha os valores reais.
# O ficheiro ".env" NUNCA deve ser commitado no Git.

# Chave secreta do Flask (usada para assinar cookies de sessão)
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=COLOQUE_UMA_CHAVE_SEGURA_AQUI

# Chave da Google Books API
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=AIzaSy_COLOQUE_SUA_CHAVE_AQUI

# Idioma dos resultados (ISO 639-1): "pt", "en", etc. Deixe vazio para sem restrição.
GOOGLE_BOOKS_LANG=
